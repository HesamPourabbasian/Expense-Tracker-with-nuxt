generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankAccounts     BankAccount[]
  transactions     Transaction[]
  cashTransactions CashTransaction[]
  debts            Debt[]
  todos            Todo[]
  cryptoTrades     CryptoTrade[]
}

model BankAccount {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  icon      String   @default("lucide:landmark")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[] @relation("AccountTransactions")
  transfersFrom Transaction[] @relation("SourceTransfers")
  transfersTo   Transaction[] @relation("DestinationTransfers")
  debts         Debt[]

  @@index([userId])
}

model Transaction {
  id                   Int      @id @default(autoincrement())
  userId               Int
  bankAccountId        Int
  type                 String
  amount               Float
  description          String?
  date                 DateTime
  isUnnecessary        Boolean  @default(false)
  sourceAccountId      Int?
  destinationAccountId Int?
  relatedTransactionId Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount        BankAccount  @relation("AccountTransactions", fields: [bankAccountId], references: [id], onDelete: Cascade)
  sourceAccount      BankAccount? @relation("SourceTransfers", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destinationAccount BankAccount? @relation("DestinationTransfers", fields: [destinationAccountId], references: [id], onDelete: Cascade)
  debt               Debt?

  @@index([userId])
  @@index([bankAccountId])
  @@index([date])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([relatedTransactionId])
}

model CashTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt Debt?

  @@index([userId])
  @@index([date])
}

model Debt {
  id                Int              @id @default(autoincrement())
  userId            Int
  person            String
  amount            Float
  type              String
  description       String?
  status            String           @default("pending")
  date              DateTime
  paymentDate       DateTime?
  bankAccountId     Int?
  isCash            Boolean          @default(false)
  transactionId     Int?             @unique
  cashTransactionId Int?             @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cashTransaction CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([transactionId])
  @@index([cashTransactionId])
}

model Todo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  date        DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CryptoTrade {
  id         Int      @id @default(autoincrement())
  userId     Int
  asset      String
  symbol     String
  type       String
  quantity   Float
  price      Float
  totalValue Float
  note       String?
  date       DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, date])
}
